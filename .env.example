# =====================================================================
# LeadGen & Booking Bot - Environment Configuration Template
# Copy this file to .env and replace placeholder values with real secrets
# =====================================================================

# Telegram Bot API Token obtained from @BotFather (Required)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_01234567

# Telegram numeric User ID of the administrator receiving lead notifications (Required)
ADMIN_ID=123456789

# SQLite database path (Optional, defaults to leads.db or /app/data/leads.db)
DB_PATH=leads.db

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (Optional, default: INFO)
LOG_LEVEL=INFO

# Google Sheets CRM Synchronization (Optional)
# Filesystem path to the Google Cloud Service Account JSON keyfile
GOOGLE_CREDS_PATH=credentials.json

# Unique ID of target Google Spreadsheet (from the spreadsheet URL)
# e.g., https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=
